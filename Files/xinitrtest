#!/bin/sh

[ -f "$HOME/.xprofile" ] && . "$HOME/.xprofile"

pgrep -x xcompmgr >/dev/null || xcompmgr -C -t .25 -r 2.2 -o .25 &

trap 'kill 0' EXIT

battery_icon() {
    case $1 in
        9[5-9]|100) echo "" ;;
        7[5-9]|8[0-9]|9[0-4]) echo "" ;;
        5[0-9]|6[0-9]|7[0-4]) echo "" ;;
        2[5-9]|3[0-9]|4[0-9]) echo "" ;;
        *) echo "" ;;
    esac
}

volume_icon() {
    [ "$2" = off ] && { echo ""; return; }
    [ "$1" -eq 0 ] && { echo ""; return; }
    [ "$1" -le 50 ] && { echo ""; return; }
    echo ""
}

have_audio=0
aplay -l 2>/dev/null | grep -q '^card' && have_audio=1

battery=
for b in /sys/class/power_supply/BAT*; do
    [ -d "$b" ] || continue
    battery=$b
    break
done

last_minute=
last_time=
last_volume=
last_network=
last_battery=
last_battery_warn=

while :; do
    updated=0

    minute=$(date +%M)
    if [ "$minute" != "$last_minute" ]; then
        last_time=$(date '+%-I:%M %p')
        last_minute=$minute
        updated=1
    fi

    volume_status=
    if [ "$have_audio" -eq 1 ]; then
        set -- $(amixer get Master | awk -F'[][]' '
            /Mono:/||/Left:/ {gsub("%",""); print $2, $6; exit}
            /Playback.*%/   {gsub("%",""); print $2, $4; exit}
        ')
        icon=$(volume_icon "$1" "$2")
        if [ "$2" = off ]; then
            volume_status="$icon Muted"
        elif [ "$1" -eq 0 ]; then
            volume_status="$icon 0%"
        else
            volume_status="$icon $1%"
        fi
        [ "$volume_status" != "$last_volume" ] && {
            last_volume=$volume_status
            updated=1
        }
    fi

    network_status=" Offline"
    for dev in /sys/class/net/*; do
        [ -f "$dev/operstate" ] || continue
        read -r state < "$dev/operstate"
        [ "$state" = up ] || continue
        iface=${dev##*/}
        case $iface in
            wl*) network_status=" $iface" ;;
            *)   network_status=" $iface" ;;
        esac
        break
    done
    [ "$network_status" != "$last_network" ] && {
        last_network=$network_status
        updated=1
    }

    battery_status=
    if [ -n "$battery" ]; then
        read -r capacity < "$battery/capacity"
        read -r status < "$battery/status"
        icon=$(battery_icon "$capacity")
        [ "$status" = Charging ] && icon="⚡$icon"
        battery_status="$icon $capacity%"

        if [ "$capacity" -le 30 ] && [ "$battery_status" != "$last_battery_warn" ]; then
            notify-send "Low Battery" "Battery at $capacity%. Please charge."
            last_battery_warn=$battery_status
        fi

        [ "$battery_status" != "$last_battery" ] && {
            last_battery=$battery_status
            updated=1
        }
    fi

    if [ "$updated" -eq 1 ]; then
        status=" $last_network"
        [ -n "$last_battery" ] && status="$status | $last_battery"
        [ -n "$last_volume" ] && status="$status | $last_volume"
        xsetroot -name "$status | $last_time "
    fi

    sleep 1
done &

exec dwm

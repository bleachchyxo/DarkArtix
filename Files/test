#!/bin/sh
[ -f "$HOME/.xprofile" ] && . "$HOME/.xprofile"
pgrep -x xcompmgr >/dev/null || xcompmgr -C -t .25 -r 2.2 -o .25 &

battery_icon() {
    case $1 in
        9[5-9]|100) echo "" ;;
        7[5-9]|8[0-9]|9[0-4]) echo "" ;;
        5[0-9]|6[0-9]|7[0-4]) echo "" ;;
        2[5-9]|3[0-9]|4[0-9]) echo "" ;;
        *) echo "" ;;
    esac
}

volume_icon() {
    [ "$2" = off ] && echo "" && return
    [ "$1" -eq 0 ] && echo "" && return
    [ "$1" -le 50 ] && echo "" && return
    echo ""
}

update_time() {
    minute=$(date +%M)
    [ "$minute" = "$last_minute" ] && return
    last_minute=$minute
    last_time=$(date '+%-I:%M %p')
    updated=1
}

update_volume() {
    [ "$have_audio" -eq 1 ] || return
    set -- $(amixer get Master | awk -F'[][]' '
        /Mono:/||/Left:/ {gsub("%",""); print $2,$6; exit}
        /Playback.*%/ {gsub("%",""); print $2,$4; exit}
    ')
    volume_status="$(volume_icon "$1" "$2")"
    if [ "$2" = off ]; then
        volume_status="$volume_status Muted"
    elif [ "$1" -eq 0 ]; then
        volume_status="$volume_status 0%"
    else
        volume_status="$volume_status $1%"
    fi
    [ "$volume_status" = "$last_volume" ] && return
    last_volume=$volume_status
    updated=1
}

# Sets $network_status directly, no subshell/command substitution
find_network_status() {
    network_status=" Offline"
    for dev in /sys/class/net/*; do
        [ -f "$dev/operstate" ] || continue
        read -r state < "$dev/operstate"
        [ "$state" = up ] || continue
        iface=${dev##*/}
        case $iface in
            wl*) network_status=" $iface" ;;
            *)   network_status=" $iface" ;;
        esac
        return
    done
}

update_network() {
    [ $((tick % 5)) -eq 0 ] || return
    find_network_status
    [ "$network_status" = "$last_network" ] && return
    last_network=$network_status
    updated=1
}

# Sets $battery directly, no subshell/command substitution
find_battery_path() {
    battery=
    for b in /sys/class/power_supply/BAT*; do
        [ -d "$b" ] && { battery=$b; return; }
    done
}

notify_battery_thresholds() {
    [ "$state" = Discharging ] || return
    if [ "$last_capacity" -gt 10 ] && [ "$capacity" -le 10 ]; then
        notify-send "Low Battery" "Battery at $capacity%. Please charge."
        low_warned=1
    fi
    if [ "$last_capacity" -gt 5 ] && [ "$capacity" -le 5 ]; then
        notify-send "Critical Battery" "Battery at $capacity%. Connect the charger."
        critical_warned=1
    fi
}

update_battery() {
    [ $((tick % 10)) -eq 0 ] || return
    find_battery_path
    if [ -z "$battery" ]; then
        [ -n "$last_battery" ] && updated=1
        last_battery=
        last_capacity=100
        return
    fi
    read -r capacity < "$battery/capacity"
    read -r state < "$battery/status"
    icon=$(battery_icon "$capacity")
    [ "$state" = Charging ] && icon="⚡$icon"
    battery_status="$icon $capacity%"
    [ "$battery_status" != "$last_battery" ] && { last_battery=$battery_status; updated=1; }
    notify_battery_thresholds
    last_capacity=$capacity
}

refresh_status_line() {
    [ "$updated" -eq 1 ] || return
    status=" $last_network"
    [ -n "$last_battery" ] && status="$status | $last_battery"
    [ -n "$last_volume" ] && status="$status | $last_volume"
    xsetroot -name "$status | $last_time "
}

have_audio=0
aplay -l 2>/dev/null | grep -q '^card' && have_audio=1

last_time=
last_minute=
last_volume=
last_network=
last_battery=
last_capacity=100
low_warned=0
critical_warned=0
tick=0

while :; do
    updated=0
    tick=$((tick + 1))
    update_time
    update_volume
    update_network
    update_battery
    refresh_status_line
    sleep .1
done &

exec dwm

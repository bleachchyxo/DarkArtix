#!/bin/bash
[ -f "$HOME/.xprofile" ] && . "$HOME/.xprofile"
pgrep -x xcompmgr >/dev/null || xcompmgr -C -t .25 -r 2.2 -o .25 &

# The status bar loop takes one step every 0.1 seconds.
# Network and bluetooth refresh every 5 steps, battery every 10.

update_time() {
    ((EPOCHSECONDS >= next_minute)) || return

    current_second=$EPOCHSECONDS
    printf -v current_time '%(%-I:%M %p)T' "$current_second"
    next_minute=$(((current_second / 60 + 1) * 60))
}

update_volume() {
    [ "$have_audio" -eq 1 ] || return

    mixer_output=$(amixer get Master)
    read -r line <<< "${mixer_output#*\[}"   # for example: 60%] [-12.00dB] [on]
    volume=${line%%\%*}

    if [[ $line == *'[off]'* ]]; then
        volume_status=" Muted"
    elif ((volume == 0)); then
        volume_status=" 0%"
    elif ((volume <= 50)); then
        volume_status=" $volume%"
    else
        volume_status=" $volume%"
    fi
}

update_network() {
    ((tick % 5 == 0)) || return

    network_status=" Offline"
    for device in /sys/class/net/*; do
        [ -f "$device/operstate" ] || continue
        read -r link_state < "$device/operstate"
        [ "$link_state" = up ] || continue

        interface=${device##*/}
        case $interface in
            wl*) network_status=" $interface" ;;
            *)   network_status=" $interface" ;;
        esac
        break
    done
}

read_bluetooth_device() {
    device_name= device_battery= device_connected=

    while read -r key value; do
        case $key in
            Name:)      device_name=$value ;;
            Connected:) device_connected=$value ;;
            Battery)    device_battery=${value#*\(}; device_battery=${device_battery%\)} ;;
        esac
    done <<< "$(bluetoothctl info "$1" 2>/dev/null)"
}

update_bluetooth() {
    ((tick % 5 == 0)) || return
    [ "$have_bluetooth" -eq 1 ] || return

    bluetooth_status=
    while read -r _ address _; do
        read_bluetooth_device "$address"
        [ "$device_connected" = yes ] || continue

        bluetooth_status=" ${device_name:-$address}"
        [ -n "$device_battery" ] && bluetooth_status+=" ($device_battery%)"
        break
    done < <(bluetoothctl devices Connected 2>/dev/null)
}

choose_battery_icon() {
    case $1 in
        9[5-9]|100)       icon="" ;;
        7[5-9]|8?|9[0-4]) icon="" ;;
        5?|6?|7[0-4])     icon="" ;;
        2[5-9]|3?|4?)     icon="" ;;
        *)                icon="" ;;
    esac
}

notify_battery_thresholds() {
    [ "$battery_state" = Discharging ] || return

    ((last_capacity > 10 && capacity <= 10)) &&
        notify-send "Low Battery" "Battery at $capacity%. Please charge."
    ((last_capacity > 5 && capacity <= 5)) &&
        notify-send "Critical Battery" "Battery at $capacity%. Connect the charger."
}

update_battery() {
    ((tick == 0)) || return

    set -- /sys/class/power_supply/BAT*
    battery_path=$1
    if [ ! -d "$battery_path" ]; then
        battery_status=
        last_capacity=100
        return
    fi

    read -r capacity < "$battery_path/capacity"
    read -r battery_state < "$battery_path/status"

    choose_battery_icon "$capacity"
    [ "$battery_state" = Charging ] && icon=" $icon"
    battery_status="$icon $capacity%"

    notify_battery_thresholds
    last_capacity=$capacity
}

refresh_status_line() {
    status=
    for part in "$bluetooth_status" "$network_status" "$volume_status" "$battery_status"; do
        [ -n "$part" ] && status="${status:+$status | }$part"
    done

    status=" $status | $current_time "
    [ "$status" = "$last_status" ] && return

    last_status=$status
    xsetroot -name "$status"
}

run_status_bar() {
    exec {idle_pipe}<> <(:)   # waiting on an idle pipe sleeps without starting a process
    tick=0

    while :; do
        tick=$(((tick + 1) % 10))

        update_time
        update_volume
        update_bluetooth
        update_network
        update_battery
        refresh_status_line

        read -rt .1 -u "$idle_pipe"
    done
}

have_audio=0
have_bluetooth=0
last_capacity=100
aplay -l 2>/dev/null | grep -q '^card' && have_audio=1
command -v bluetoothctl >/dev/null && have_bluetooth=1

run_status_bar &
exec dwm
